#!/usr/bin/env bash
# dot — versioned, selective dotfiles CLI.
# Design decisions are captured in ~/vault/context/dot-cli.md (recreation
# prompt); this script is the source of truth for behavior.
#
# Config verbs manage the machine (store + lockfile + ~/.config).
# Runtime verbs drive herdr (see §3.2 of the MVP spec).
#
# Deps: bash, git, jq, coreutils. No bash 4+ features (macOS ships 3.2).

set -uo pipefail
DOT_VERSION="1.0.0"

# ── output ─────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  R=$'\033[0m'; B=$'\033[1;34m'; Y=$'\033[1;33m'; E=$'\033[1;31m'; G=$'\033[1;32m'
else
  R=; B=; Y=; E=; G=
fi
log()  { printf '%s==>%s %s\n' "$B" "$R" "$*"; }
warn() { printf '%swarn%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%serr%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

# ── paths ──────────────────────────────────────────────────────────────
DEFAULT_REPO_URL="${DOT_REPO_URL:-https://github.com/chintak/dotfiles.git}"
DOT_REF="${DOT_REF:-master}"
DOT_BIN_DIR="${DOT_BIN_DIR:-$HOME/.local/bin}"
DOT_STORE="${DOT_STORE:-$HOME/.local/share/dot/store}"
DOT_STATE="${DOT_STATE:-$HOME/.local/state/dot}"
LOCKFILE="$DOT_STATE/installed.json"

self_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
default_repo() {
  local self; self="$(self_path)"
  if [[ -n "$self" && -d "$self/configs" ]]; then printf '%s' "$self"; return; fi
  # canonical clone (a machine with ~/git/dotfiles checked out): prefer it
  # over the ephemeral fallback, which may not exist
  if [[ -d "$HOME/git/dotfiles/configs" ]]; then printf '%s' "$HOME/git/dotfiles"; return; fi
  printf '%s' "$HOME/.local/share/dot/repo"
}
REPO="${DOT_REPO:-$(default_repo)}"
CONFIGS_DIR="$REPO/configs"
PROFILES_DIR="$REPO/profiles"

# ── small helpers ──────────────────────────────────────────────────────
sha256() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'; else sha256sum | awk '{print $1}'; fi; }
expand() { local p="$1"; p="${p/#\~/$HOME}"; p="${p//\$\{HOME\}/$HOME}"; p="${p//\$HOME/$HOME}"; printf '%s' "$p"; }
host_platform() { case "$(uname -s)" in Darwin) echo mac ;; Linux) echo linux ;; *) echo unknown ;; esac; }
ver_gt() { [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]; }
semver_ok() { printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; }

mget()     { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -1; }
mget_all() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1"; }

config_dir()    { printf '%s/%s' "$CONFIGS_DIR" "$1"; }
all_configs()   { ( cd "$CONFIGS_DIR" 2>/dev/null && for d in */; do [[ -f "$d/manifest" ]] && printf '%s\n' "${d%/}"; done ) | sort; }
profile_configs() {
  local f="$PROFILES_DIR/$1.conf"
  [[ -f "$f" ]] || die "no such profile: $1 (looked for $f)"
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$f"
}
hash_dir() { ( cd "$1" 2>/dev/null && find . -type f | LC_ALL=C sort | while IFS= read -r f; do shasum -a 256 "$f" 2>/dev/null || sha256sum "$f"; done | sha256 ); }

# ── lockfile (JSON, jq) ────────────────────────────────────────────────
lock_init() { mkdir -p "$DOT_STATE"; [[ -f "$LOCKFILE" ]] || printf '{"lockfileVersion":1,"configs":{}}\n' > "$LOCKFILE"; }
lock_read() { lock_init; cat "$LOCKFILE"; }
lock_get()  { lock_read | jq -c --arg n "$1" '.configs[$n] // empty' 2>/dev/null; }
lock_set()  { lock_init; local tmp; tmp="$(mktemp)"; lock_read | jq --arg n "$1" --argjson v "$2" '.configs[$n]=$v' > "$tmp" && mv "$tmp" "$LOCKFILE"; }
lock_del()  { lock_init; local tmp; tmp="$(mktemp)"; lock_read | jq --arg n "$1" 'del(.configs[$n])' > "$tmp" && mv "$tmp" "$LOCKFILE"; }
lock_names() { lock_read | jq -r '.configs | keys[]' 2>/dev/null; }

need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

# _refresh_completion — keep the bootstrap-installed zsh completion in sync
# with the repo. bootstrap.sh drops completions/_dot next to the dotfiles
# clone; whenever the repo copy differs (e.g. after a pull), copy it over.
# Called from init/update/apply — apply because it is the verb most likely
# run right after editing completions in-repo.
_refresh_completion() {
  local src="$REPO/completions/_dot" dst="$HOME/.local/share/dot/completions/_dot"
  [[ -f "$src" ]] || return 0
  [[ -f "$dst" ]] && cmp -s "$src" "$dst" 2>/dev/null && return 0
  mkdir -p "${dst%/*}" && cp "$src" "$dst" || warn "could not refresh zsh completion ($dst)"
}

# ── apply ──────────────────────────────────────────────────────────────
# apply_config <name> [--dry-run] [--force-post]
apply_config() {
  local name="$1"; shift
  local dry=0 force_post=0 a
  for a in "$@"; do case "$a" in --dry-run) dry=1 ;; --force-post) force_post=1 ;; esac; done

  local dir mf ver desc post
  dir="$(config_dir "$name")"; mf="$dir/manifest"
  [[ -f "$mf" ]] || die "unknown config: $name"
  ver="$(mget "$mf" version)"; desc="$(mget "$mf" description)"
  post="$(mget "$mf" post_apply)"

  local plat; plat="$(mget "$mf" platform)"
  if [[ -n "$plat" && "$plat" != "any" && "$plat" != "$(host_platform)" ]]; then
    warn "$name: skipped (platform=$plat, host=$(host_platform))"; return 0
  fi

  local req
  for req in $(mget "$mf" requires | tr ',' ' '); do
    [[ -z "$req" ]] && continue
    [[ -n "$(lock_get "$req")" ]] || { log "$name requires $req"; apply_config "$req" "$@"; }
  done

  local files=() entry
  while IFS= read -r entry; do [[ -n "$entry" ]] && files+=("$entry"); done < <(mget_all "$mf" file)
  [[ ${#files[@]} -gt 0 || -n "$post" ]] || die "$name: manifest declares neither file nor post_apply"

  local mode="${DOT_MODE:-symlink}"
  local stage store_dir=""
  if [[ "$mode" == copy ]]; then
    stage="$(mktemp -d)"
  else
    store_dir="$DOT_STORE/$name/$ver"
    stage="$store_dir"
  fi
  if (( dry )); then
    printf '  %s %s (%s)\n' "$name" "$ver" "$mode"
    for entry in "${files[@]}"; do printf '      %s -> %s\n' "${entry%%|*}" "$(expand "${entry#*|}")"; done
    return 0
  fi

  rm -rf "$stage"; mkdir -p "$stage"
  for entry in "${files[@]}"; do
    local src="${entry%%|*}"
    if [[ -d "$dir/files/$src" ]]; then
      mkdir -p "$stage/$src"; cp -R "$dir/files/$src/." "$stage/$src/"
    else
      [[ -f "$dir/files/$src" ]] || die "$name: missing files/$src"
      mkdir -p "$stage/$(dirname "$src")"; cp "$dir/files/$src" "$stage/$src"
    fi
  done

  local hash; hash="$(hash_dir "$stage")"
  local targets=() dst
  for entry in "${files[@]}"; do
    local src="${entry%%|*}"; dst="$(expand "${entry#*|}")"
    targets+=("$dst"); mkdir -p "$(dirname "$dst")"
    if [[ -e "$dst" && ! -L "$dst" ]]; then
      mv "$dst" "$dst.bak.$(date +%Y%m%d-%H%M%S)"; warn "backed up $dst"
    fi
    if [[ "$mode" == copy ]]; then
      rm -f "$dst"; cp -R "$stage/$src" "$dst"
    else
      ln -sfn "$stage/$src" "$dst"
    fi
  done
  [[ "$mode" == copy ]] && rm -rf "$stage"

  local apply_hash; apply_hash="$(printf '%s\n%s\n%s\n' "$ver" "$hash" "$post" | sha256)"
  local prev prev_ah; prev="$(lock_get "$name")"
  prev_ah="$(printf '%s' "$prev" | jq -r '.applyHash // empty' 2>/dev/null)"

  local post_ok="true"
  if [[ -n "$post" ]]; then
    if (( force_post )) || [[ "$prev_ah" != "$apply_hash" ]]; then
      log "$name: post_apply"
      bash -lc "$post" || { warn "$name: post_apply failed"; post_ok="false"; }
    fi
  fi

  local targets_json; targets_json="$(printf '%s\n' "${targets[@]}" | jq -R . | jq -s .)"
  lock_set "$name" "$(jq -n \
    --arg version "$ver" --arg mode "$mode" \
    --arg hash "$hash" --arg applyHash "$apply_hash" --arg store "$store_dir" \
    --argjson targets "$targets_json" --argjson postApplyOk "$post_ok" \
    --arg installedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{version:$version,mode:$mode,hash:$hash,applyHash:$applyHash,
      store:$store,targets:$targets,postApplyOk:$postApplyOk,installedAt:$installedAt}')"

  log "$name $ver"
  [[ "$post_ok" == "true" ]] || return 1
}

apply_targets() { # <names...> [flags]
  local names=() flags=() a
  for a in "$@"; do
    case "$a" in --dry-run|--force-post) flags+=("$a") ;; *) names+=("$a") ;; esac
  done
  local rc=0 n
  for n in "${names[@]}"; do apply_config "$n" "${flags[@]+"${flags[@]}"}" || rc=1; done
  return $rc
}

# ── config state ───────────────────────────────────────────────────────
config_state() { # <name> -> ok|not-installed|broken|drifted|modified|stale|inapplicable
  local name="$1" dir mf entry
  dir="$(config_dir "$name")"; mf="$dir/manifest"
  local avail; avail="$(mget "$mf" version)"
  local plat; plat="$(mget "$mf" platform)"
  [[ -n "$plat" && "$plat" != "any" && "$plat" != "$(host_platform)" ]] && { echo inapplicable; return; }

  local rec; rec="$(lock_get "$name")"
  [[ -z "$rec" ]] && { echo not-installed; return; }

  local mode; mode="$(printf '%s' "$rec" | jq -r '.mode // "symlink"')"
  local inst; inst="$(printf '%s' "$rec" | jq -r '.version')"

  if [[ "$mode" == copy ]]; then
    local t
    while IFS= read -r t; do
      [[ -z "$t" ]] && continue
      [[ -e "$(expand "$t")" ]] || { echo broken; return; }
    done < <(printf '%s' "$rec" | jq -r '.targets[]?')
    ver_gt "$avail" "$inst" && { echo stale; return; }
    echo ok; return
  fi

  local store hash
  store="$(printf '%s' "$rec" | jq -r '.store')"
  hash="$(printf '%s' "$rec" | jq -r '.hash')"
  [[ -d "$store" ]] || { echo broken; return; }

  local t
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    t="$(expand "$t")"
    [[ -L "$t" && "$(readlink "$t")" == "$store"/* ]] || { echo drifted; return; }
  done < <(printf '%s' "$rec" | jq -r '.targets[]?')

  [[ "$(hash_dir "$store")" == "$hash" ]] || { echo modified; return; }
  ver_gt "$avail" "$inst" && { echo stale; return; }
  [[ "$(printf '%s' "$rec" | jq -r '.postApplyOk')" == "false" ]] && { echo post-failed; return; }
  echo ok
}

# ── commands: config ───────────────────────────────────────────────────
cmd_list() {
  local mode=all json=0
  while (( $# )); do
    case "$1" in
      --installed) mode=installed; shift ;;
      --available) mode=available; shift ;;
      --json) json=1; shift ;;
      *) shift ;;
    esac
  done

  if (( json )); then
    local items="[]" n st
    for n in $(all_configs); do
      local mf; mf="$(config_dir "$n")/manifest"
      st="$(config_state "$n")"
      [[ "$mode" == installed && "$st" == not-installed ]] && continue
      [[ "$mode" == available && "$st" != not-installed ]] && continue
      items="$(printf '%s' "$items" | jq \
        --arg n "$n" --arg v "$(mget "$mf" version)" --arg d "$(mget "$mf" description)" \
        --arg s "$st" \
        --arg i "$(lock_get "$n" | jq -r '.version // ""' 2>/dev/null)" \
        '. + [{name:$n,installed:$i,available:$v,description:$d,state:$s}]')"
    done
    printf '%s\n' "$items" | jq .
    return
  fi

  local n mf st
  for n in $(all_configs); do
    mf="$(config_dir "$n")/manifest"; st="$(config_state "$n")"
    [[ "$mode" == installed && "$st" == not-installed ]] && continue
    [[ "$mode" == available && "$st" != not-installed ]] && continue
    printf '%-12s %-8s %-12s %s\n' "$n" "$(mget "$mf" version)" "$st" "$(mget "$mf" description)"
  done
  printf '\n'
}

cmd_info() {
  [[ $# -ge 1 ]] || die "usage: dot info <config>"
  local n="$1" dir mf
  dir="$(config_dir "$n")"; mf="$dir/manifest"
  [[ -f "$mf" ]] || die "unknown config: $n"
  printf '%s%s%s  %s\n' "$B" "$n" "$R" "$(mget "$mf" description)"
  printf '  version   %s\n  platform  %s\n  state     %s\n' \
    "$(mget "$mf" version)" "$(mget "$mf" platform)" "$(config_state "$n")"
  local r; r="$(mget "$mf" requires)"; [[ -n "$r" ]] && printf '  requires  %s\n' "$r"
  local p; p="$(mget "$mf" post_apply)"; [[ -n "$p" ]] && printf '  post_apply  %s\n' "$p"
  printf '  files:\n'
  local entry; while IFS= read -r entry; do
    [[ -n "$entry" ]] && printf '    %-28s -> %s\n' "${entry%%|*}" "${entry#*|}"
  done < <(mget_all "$mf" file)
  printf '  path      %s\n' "$dir"
}

cmd_apply() {
  local names=() profile="" flags=() a dry=0
  while (( $# )); do
    case "$1" in
      --profile) profile="$2"; shift 2 ;;
      --profile=*) profile="${1#*=}"; shift ;;
      --dry-run) dry=1; flags+=("$1"); shift ;;
      --force-post) flags+=("$1"); shift ;;
      -*) die "unknown flag: $1" ;;
      *) names+=("$1"); shift ;;
    esac
  done
  # --dry-run promises to touch nothing; _refresh_completion copies the
  # repo completion over the installed one, so run it only when the apply
  # is real. (Side effects after flag parsing, never before.)
  (( dry )) || _refresh_completion
  if [[ -n "$profile" ]]; then
    [[ -f "$PROFILES_DIR/$profile.conf" ]] || die "no such profile: $profile"
    local c; while IFS= read -r c; do names+=("$c"); done < <(profile_configs "$profile")
  fi
  [[ ${#names[@]} -gt 0 ]] || { while IFS= read -r c; do names+=("$c"); done < <(all_configs); }
  apply_targets "${names[@]}" "${flags[@]+"${flags[@]}"}"
}

cmd_forget() {
  [[ $# -ge 1 ]] || die "usage: dot forget <config>..."
  local n rec t rc=0
  for n in "$@"; do
    rec="$(lock_get "$n")"
    [[ -z "$rec" ]] && { warn "$n: not installed"; continue; }
    while IFS= read -r t; do
      [[ -z "$t" ]] && continue
      t="$(expand "$t")"
      if [[ -L "$t" ]]; then rm -f "$t"; log "removed $t"; fi
    done < <(printf '%s' "$rec" | jq -r '.targets[]?')
    lock_del "$n"; log "forgot $n (store kept)"
  done
  return $rc
}

cmd_status() {
  local json=0 exit_code=0 a
  for a in "$@"; do case "$a" in --json) json=1 ;; --exit-code) exit_code=1 ;; esac; done
  if (( json )); then
    local items="[]" n st
    for n in $(all_configs); do
      local mf; mf="$(config_dir "$n")/manifest"; st="$(config_state "$n")"
      items="$(printf '%s' "$items" | jq --arg n "$n" --arg v "$(mget "$mf" version)" --arg s "$st" \
        --arg i "$(lock_get "$n" | jq -r '.version // ""' 2>/dev/null)" \
        '. + [{name:$n,installed:$i,available:$v,state:$s}]')"
    done
    printf '%s\n' "$items" | jq .
  else
    printf '%-12s %-9s %-9s %s\n' config installed available state
    local n mf st inst avail
    for n in $(all_configs); do
      mf="$(config_dir "$n")/manifest"; st="$(config_state "$n")"
      inst="$(lock_get "$n" | jq -r '.version // "—"' 2>/dev/null)"; [[ -z "$inst" ]] && inst="—"
      avail="$(mget "$mf" version)"
      printf '%-12s %-9s %-9s %s\n' "$n" "$inst" "$avail" "$st"
    done
  fi
  if (( exit_code )); then
    local pending=0
    for n in $(all_configs); do
      st="$(config_state "$n")"
      case "$st" in ok|not-installed|inapplicable) ;; *) pending=1 ;; esac
    done
    return $pending
  fi
}

cmd_diff() {
  [[ $# -ge 1 ]] || die "usage: dot diff <config>"
  local n="$1" rec store dir
  rec="$(lock_get "$n")"; [[ -n "$rec" ]] || die "$n: not installed"
  store="$(printf '%s' "$rec" | jq -r '.store')"
  dir="$(config_dir "$n")"
  local entry rc=0
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    local src="${entry%%|*}"
    if [[ -d "$dir/files/$src" ]]; then
      diff -ru "$store/$src" "$dir/files/$src" || rc=1
    else
      diff -u "$store/$src" "$dir/files/$src" || rc=1
    fi
  done < <(mget_all "$dir/manifest" file)
  (( rc )) || log "in sync"
}

cmd_edit() {
  [[ $# -ge 1 ]] || die "usage: dot edit <config>"
  local n="$1" dir; dir="$(config_dir "$n")"
  [[ -d "$dir" ]] || die "unknown config: $n"
  local ed="${EDITOR:-vi}"
  local first; first="$(mget_all "$dir/manifest" file | head -1)"
  if [[ -n "$first" ]]; then exec "$ed" "$dir/files/${first%%|*}"; else exec "$ed" "$dir"; fi
}

cmd_cd() { exec "${SHELL:-/bin/sh}" -c "cd '$REPO' && exec ${SHELL:-/bin/sh} -l"; }

cmd_profiles() {
  local p c a json=0
  for a in "$@"; do [[ "$a" == "--json" ]] && json=1; done
  if (( json )); then
    # [{name,configs:[…]}] — mirrors cmd_list --json's jq-built array style
    local items="[]" cfgs cc cjson
    for p in "$PROFILES_DIR"/*.conf; do
      [[ -f "$p" ]] || continue
      local -a cfgs=()
      while IFS= read -r cc; do [[ -n "$cc" ]] && cfgs+=("$cc"); done \
        < <(profile_configs "$(basename "$p" .conf)")
      if (( ${#cfgs[@]} )); then
        cjson="$(printf '%s\n' "${cfgs[@]}" | jq -R . | jq -s .)"
      else
        cjson="[]"
      fi
      items="$(printf '%s' "$items" | jq \
        --arg n "$(basename "$p" .conf)" --argjson c "$cjson" \
        '. + [{name:$n,configs:$c}]')"
    done
    printf '%s\n' "$items" | jq .
    return
  fi
  for p in "$PROFILES_DIR"/*.conf; do
    [[ -f "$p" ]] || continue
    printf '%s%s%s\n' "$B" "$(basename "$p" .conf)" "$R"
    while IFS= read -r c; do printf '  %s\n' "$c"; done < <(profile_configs "$(basename "$p" .conf)")
  done
}

cmd_doctor() {
  local fail=0
  check() { if eval "$2" >/dev/null 2>&1; then printf '  %s✓%s %s\n' "$G" "$R" "$1"; else printf '  %s✗%s %s\n' "$E" "$R" "$1"; fail=1; fi; }
  printf 'dependencies\n'
  check "git"        "command -v git"
  check "jq"         "command -v jq"
  check "curl"       "command -v curl"
  printf 'repo\n'
  check "repo exists ($REPO)" "[[ -d '$REPO' ]]"
  check "is a git repo"       "git -C '$REPO' rev-parse --git-dir"
  check "not mid-rebase"      "[[ ! -d '$REPO/.git/rebase-merge' && ! -d '$REPO/.git/rebase-apply' ]]"
  check "configs/ present"    "[[ -d '$CONFIGS_DIR' ]]"
  printf 'environment\n'
  check "dot installed ($DOT_BIN_DIR/dot)" "[[ -x '$DOT_BIN_DIR/dot' ]]"
  check "~/.local/bin on PATH" "case ':$PATH:' in *':$DOT_BIN_DIR:'*) true;; *) false;; esac"
  check "store writable"       "mkdir -p '$DOT_STORE' && [[ -w '$DOT_STORE' ]]"
  check "state writable"       "mkdir -p '$DOT_STATE' && [[ -w '$DOT_STATE' ]]"
  if command -v dot >/dev/null 2>&1 && [[ "$(command -v dot)" != "$DOT_BIN_DIR/dot" ]]; then
    warn "another 'dot' shadows this one: $(command -v dot)"
  fi
  printf 'manifests\n'
  local n mf bad=0
  for n in $(all_configs); do
    mf="$(config_dir "$n")/manifest"
    if ! semver_ok "$(mget "$mf" version)"; then warn "$n: invalid semver '$(mget "$mf" version)'"; bad=1; fi
    [[ -n "$(mget "$mf" description)" ]] || { warn "$n: missing description"; bad=1; }
  done
  [[ $bad -eq 0 ]] && printf '  %s✓%s all %s manifests valid\n' "$G" "$R" "$(all_configs | wc -l | tr -d ' ')" || fail=1
  printf 'lockfile\n'
  if [[ -f "$LOCKFILE" ]]; then
    if jq empty "$LOCKFILE" >/dev/null 2>&1; then
      printf '  %s✓%s parses\n' "$G" "$R"
      local rec store
      for n in $(lock_names); do
        rec="$(lock_get "$n")"; store="$(printf '%s' "$rec" | jq -r '.store')"
        [[ -d "$store" ]] || { warn "$n: store missing ($store)"; fail=1; }
      done
    else
      printf '  %s✗%s does not parse\n' "$E" "$R"; fail=1
    fi
  else
    printf '  %s·%s no lockfile yet\n' "$Y" "$R"
  fi
  printf '\n'
  if (( fail )); then printf '%sdoctor: problems found%s\n' "$E" "$R"; return 1; fi
  printf '%sdoctor: all good%s\n' "$G" "$R"
}

cmd_update() {
  local pull=1 names=() a
  while (( $# )); do case "$1" in --no-pull) pull=0; shift ;; --dry-run) a="$1"; shift; names+=("$a") ;; -*) shift ;; *) names+=("$1"); shift ;; esac; done
  if (( pull )); then
    if [[ -d "$REPO/.git" ]]; then
      log "git pull --rebase --autostash"
      git -C "$REPO" pull --rebase --autostash || die "git pull failed"
    else
      warn "not a git clone; skipping pull"
    fi
  fi
  _refresh_completion
  local installed=(); local n
  if [[ ${#names[@]} -gt 0 ]]; then installed=("${names[@]}")
  else while IFS= read -r n; do installed+=("$n"); done < <(lock_names); fi
  [[ ${#installed[@]} -gt 0 ]] || { log "nothing installed"; return 0; }

  local updated=0 failed=0
  for n in "${installed[@]}"; do
    [[ -f "$(config_dir "$n")/manifest" ]] || { warn "$n: no longer in repo"; continue; }
    local avail inst; avail="$(mget "$(config_dir "$n")/manifest" version)"
    inst="$(lock_get "$n" | jq -r '.version')"
    if ver_gt "$avail" "$inst"; then
      log "$n $inst -> $avail"
      if apply_config "$n"; then updated=$((updated+1)); else failed=$((failed+1)); fi
    fi
  done
  log "$updated updated, $failed failed"
  (( failed == 0 ))
}

cmd_rollback() {
  [[ $# -ge 1 ]] || die "usage: dot rollback <config> [version]"
  local n="$1" want="${2:-}" rec store root cur versions target
  rec="$(lock_get "$n")"; [[ -n "$rec" ]] || die "$n: not installed"
  root="$DOT_STORE/$n"
  [[ -d "$root" ]] || die "$n: no store versions"
  if [[ -z "$want" ]]; then
    versions="$(ls -1 "$root" 2>/dev/null | sort -Vr)"
    cur="$(printf '%s' "$rec" | jq -r '.version')"
    want="$(printf '%s\n' "$versions" | grep -vx "$cur" | head -1)"
    [[ -n "$want" ]] || die "$n: no other version to roll back to"
  fi
  target="$root/$want"
  [[ -d "$target" ]] || die "$n: version $want not in store"
  local entry t
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    t="$(expand "${entry#*|}")"; ln -sfn "$target/${entry%%|*}" "$t"; log "$t -> $target/${entry%%|*}"
  done < <(mget_all "$(config_dir "$n")/manifest" file)
  local h; h="$(hash_dir "$target")"
  lock_set "$n" "$(printf '%s' "$rec" | jq --arg v "$want" --arg s "$target" --arg h "$h" \
    '.version=$v | .store=$s | .hash=$h')"
  log "rolled back $n to $want"
}

cmd_bump() {
  [[ $# -ge 2 ]] || die "usage: dot bump <config> <major|minor|patch>"
  local n="$1" level="$2" mf; mf="$(config_dir "$n")/manifest"
  [[ -f "$mf" ]] || die "unknown config: $n"
  local cur; cur="$(mget "$mf" version)"
  semver_ok "$cur" || die "$n: invalid version '$cur'"
  local maj min pat; IFS=. read -r maj min pat <<< "$cur"
  case "$level" in
    major) maj=$((maj+1)); min=0; pat=0 ;;
    minor) min=$((min+1)); pat=0 ;;
    patch) pat=$((pat+1)) ;;
    *) die "level must be major|minor|patch" ;;
  esac
  local new="$maj.$min.$pat"
  local tmp; tmp="$(mktemp)"
  sed "s/^version[[:space:]]*=.*/version     = $new/" "$mf" > "$tmp" && mv "$tmp" "$mf"
  log "$n $cur -> $new"
  if [[ -d "$REPO/.git" ]]; then
    git -C "$REPO" add "$(config_dir "$n")/manifest" 2>/dev/null
    git -C "$REPO" commit -q -m "chore($n): bump $cur -> $new" 2>/dev/null && log "committed" || warn "commit skipped"
  fi
  printf 'next: dot apply %s\n' "$n"
}

cmd_add() {
  [[ $# -ge 1 ]] || die "usage: dot add <path>"
  local src="$1"; [[ -e "$src" ]] || die "no such path: $src"
  local base; base="$(basename "$src")"
  local name="${base#.}"; name="${name%%.*}"
  local description=""
  if [[ -t 0 ]]; then
    read -r -p "description [$name]: " description
  fi
  [[ -n "$description" ]] || description="$name"
  local dir; dir="$(config_dir "$name")"
  [[ -e "$dir" ]] && die "$name: config already exists ($dir)"
  mkdir -p "$dir/files"
  cp -R "$src" "$dir/files/$base"
  cat > "$dir/manifest" <<EOF
version     = 0.1.0
description = $description
file        = $base|$(expand "$src")
EOF
  printf '# %s\n\nAdopted from `%s` via `dot add`.\n' "$name" "$src" > "$dir/README.md"
  log "added $name"
  apply_config "$name"
}

# ── gc ─────────────────────────────────────────────────────────────────
# gc: prune superseded store versions of installed configs.
# Stores of configs absent from the lockfile are kept — `dot forget` keeps
# the store by design, and rollback of an uninstalled config stays possible.
cmd_gc() {
  local dry=0 a
  for a in "$@"; do
    case "$a" in
      --dry-run) dry=1 ;;
      *) die "unknown flag: $a" ;;
    esac
  done
  [[ -d "$DOT_STORE" ]] || die "no store at $DOT_STORE"
  [[ -f "$LOCKFILE" ]] || die "no lockfile at $LOCKFILE"

  local pruned=0 kept=0 cfg cfg_dir installed vdir v
  for cfg_dir in "$DOT_STORE"/*/; do
    [[ -d "$cfg_dir" ]] || continue
    cfg="$(basename "$cfg_dir")"
    installed="$(lock_get "$cfg" | jq -r '.version // empty' 2>/dev/null)"
    if [[ -z "$installed" ]]; then
      warn "$cfg: not installed; keeping store ($(ls "$cfg_dir" | tr '\n' ' '))"
      continue
    fi
    for vdir in "$cfg_dir"*/; do
      [[ -d "$vdir" ]] || continue
      v="$(basename "$vdir")"
      if [[ "$v" == "$installed" ]]; then continue; fi
      if (( dry )); then
        printf '  would prune %s/%s\n' "$cfg" "$v"
      else
        rm -rf "$vdir" && { printf '  pruned %s/%s\n' "$cfg" "$v"; pruned=$((pruned+1)); }
      fi
    done
    if [[ -z "$(ls -A "$cfg_dir")" ]]; then rmdir "$cfg_dir"; fi
  done
  if (( dry )); then
    log "gc --dry-run done (nothing removed)"
  else
    log "gc pruned $pruned version dir(s)"
  fi
  return 0
}

cmd_purge() {
  local yes=0 a; for a in "$@"; do [[ "$a" == "--yes" ]] && yes=1; done
  local default_repo_path; default_repo_path="$HOME/.local/share/dot/repo"
  if [[ "$REPO" != "$default_repo_path" ]]; then
    warn "repo is not the default clone ($REPO); refusing to delete it"
    warn "pass --force only if you really mean it"
    [[ " $* " == *" --force "* ]] || return 1
  fi
  printf 'will remove:\n  %s\n  %s\n  %s\n  %s\n  %s\n' \
    "$REPO" "$DOT_STORE" "$DOT_STATE" "$DOT_BIN_DIR/dot" \
    "$HOME/.local/share/dot/completions"
  if (( ! yes )); then
    [[ -t 0 ]] || die "refusing without --yes"
    read -r -p "purge? [y/N] " ans; [[ "$ans" == "y" || "$ans" == "Y" ]] || { log "aborted"; return 1; }
  fi
  rm -rf "$REPO" "$DOT_STORE" "$DOT_STATE" "$HOME/.local/share/dot/completions"
  rm -f "$DOT_BIN_DIR/dot"
  log "purged (config files at their targets are untouched)"
}

cmd_init() {
  local profile="" repo_url="$DEFAULT_REPO_URL" ref="$DOT_REF" ephemeral=0 a
  while (( $# )); do
    case "$1" in
      --profile) profile="$2"; shift 2 ;;
      --profile=*) profile="${1#*=}"; shift ;;
      --repo) repo_url="$2"; shift 2 ;;
      --repo=*) repo_url="${1#*=}"; shift ;;
      --ref) ref="$2"; shift 2 ;;
      --ref=*) ref="${1#*=}"; shift ;;
      --ephemeral|--vm) ephemeral=1; shift ;;
      *) shift ;;
    esac
  done

  local cloned=0
  if [[ ! -d "$REPO/configs" ]]; then
    need git
    log "cloning $repo_url -> $REPO"
    mkdir -p "$(dirname "$REPO")"
    git clone --depth 1 --branch "$ref" "$repo_url" "$REPO" || die "clone failed"
    cloned=1
  else
    log "repo already present: $REPO"
  fi

  [[ -n "$profile" ]] || die "dot init requires --profile <name>"
  [[ -f "$PROFILES_DIR/$profile.conf" ]] || die "no such profile: $profile"
  log "applying profile: $profile"
  local names=() c
  while IFS= read -r c; do names+=("$c"); done < <(profile_configs "$profile")

  # Ephemeral installs are plain copies — the store is deleted afterwards.
  if (( ephemeral )); then export DOT_MODE=copy; fi
  apply_targets "${names[@]}" || warn "some configs failed"
  _refresh_completion

  if (( ephemeral )); then
    log "ephemeral: purging tooling"
    if (( cloned )) || [[ "$REPO" == "$HOME/.local/share/dot/repo" ]]; then
      rm -rf "$REPO"
    else
      warn "not purging $REPO (not cloned by init — refusing to delete a working checkout)"
    fi
    rm -rf "$DOT_STORE" "$DOT_STATE" "$DOT_BIN_DIR/dot"
    log "done — configs installed, no tooling left behind"
  fi
}

# ── runtime verbs ──────────────────────────────────────────────────────
TYPES="feat fix docs style refactor perf test build ci chore revert"

cmd_name() {
  local type="${1:-}"; shift || true
  [[ -n "$type" ]] || die "usage: dot name <type> <word>..."
  if [[ "$type" != "--type-any" && " $TYPES " != *" $type "* ]]; then
    die "invalid type '$type' (one of: $TYPES)"
  fi
  local words=() w
  for w in "$@"; do
    w="$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
    [[ -n "$w" ]] && words+=("$w")
  done
  [[ ${#words[@]} -gt 0 ]] || die "no usable words"

  local slug="${words[0]}" i cand
  for (( i = 1; i < ${#words[@]} && i < 3; i++ )); do
    cand="$slug-${words[$i]}"
    (( ${#type} + 1 + ${#cand} <= 32 )) || break
    slug="$cand"
  done

  local id="$type-$slug"
  while (( ${#id} > 32 )); do
    [[ "$slug" == *-* ]] || { slug="${slug:0:24}"; id="$type-$slug"; break; }
    slug="${slug%-*}"; id="$type-$slug"
  done
  printf '%s\n' "$id"
}

runtime_stub() {
  local verb="$1"; shift
  printf '%serr%s dot %s is specified but not implemented yet.\n' "$E" "$R" "$verb" >&2
  return 2
}

# ── transcript ─────────────────────────────────────────────────────────
# Deterministic session export (no LLM). Reads the live opencode store
# (session_v2 + session_message + instruction_state/instruction_blob) and
# writes, per session:
#   .raw/<ses>/messages.jsonl    every session_message row, in seq order
#   .raw/<ses>/context.json      harness snapshot, content-addressed
#   sessions/<date>-<slug>.md    memo skeleton (frontmatter + turn outline)
# No wall-clock timestamps go into the output, so re-runs are idempotent.
ODB="${DOT_OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"

epoch_date() { date -r "$1" +%Y-%m-%d 2>/dev/null || date -d "@$1" +%Y-%m-%d; }

yaml_str() { jq -n --arg s "$1" '$s'; }   # a JSON string is a valid YAML scalar
yaml_list() { # <key> <json-string-array> <key-indent> <item-indent>
  local key="$1" arr="$2" kpad="$3" pad="$4"
  if [[ "$(jq 'length' <<< "$arr")" == "0" ]]; then printf '%s%s: []\n' "$kpad" "$key"; return; fi
  printf '%s%s:\n' "$kpad" "$key"
  jq -r --arg pad "$pad" '.[] | $pad + "- " + .' <<< "$arr"
}

project_of() { # <directory> -> vault project name (best effort)
  local dir="$1" top base
  if [[ -z "$dir" ]]; then printf 'user\n'; return; fi
  dir="$(expand "$dir")"
  if [[ "$dir" == "$HOME" || "$dir" == "$HOME/" ]]; then printf 'user\n'; return; fi
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
  [[ -n "$top" ]] || top="$dir"
  case "$top" in */.worktrees/*) top="${top%%/.worktrees/*}" ;; esac
  base="$(basename "$top")"; [[ -n "$base" && "$base" != "/" ]] || base=user
  printf '%s\n' "$base"
}

memo_slug() { # <title> <fallback> — `dot name` slug with its type prefix stripped
  local title="$1" fallback="$2" slug="" words=()
  if [[ -n "$title" ]]; then
    IFS=' ' read -r -a words <<< "$title"
  fi
  if [[ ${#words[@]} -gt 0 ]]; then
    # `dot name` needs a conventional-commit type; `chore` is a neutral prefix
    # used only to reuse its slug rules, and is stripped back off.
    slug="$(cmd_name chore "${words[@]}" 2>/dev/null)"
    slug="${slug#chore-}"
  fi
  printf '%s\n' "${slug:-$fallback}"
}

transcript_export() { # <session-id> <vault> <can-commit> <why>
  local sid="$1" vault="$2" can_commit="$3" why="$4"
  local raw="$vault/.raw/$sid"
  mkdir -p "$raw" "$vault/sessions" || return 1

  local sess title dir created
  sess="$(sqlite3 -json "$ODB" "select id,slug,title,directory,agent,model,time_created,time_updated from session_v2 where id='$sid'")"
  [[ "$sess" != "[]" && -n "$sess" ]] || { warn "$sid: not in session_v2"; return 1; }
  title="$(jq -r '.[0].title // ""' <<< "$sess")"
  dir="$(jq -r '.[0].directory // ""' <<< "$sess")"
  created="$(jq -r '.[0].time_created' <<< "$sess")"

  # 1. messages.jsonl — faithful, self-describing rows in seq order.
  sqlite3 -json "$ODB" \
    "select seq,type,time_created,data from session_message where session_id='$sid' order by seq" |
  jq -c '.[] | (.data | fromjson) as $d
         | {seq, type, time: .time_created,
            model: (if ($d.model | type) == "object" then (($d.model.providerID // "") + "/" + ($d.model.id // ""))
                    elif ($d.model | type) == "string" then $d.model else null end),
            agent: ($d.agent // null),
            content: ($d.content // null),
            data: $d}' > "$raw/messages.jsonl" || return 1
  if [[ -s "$raw/messages.jsonl" ]] && ! jq -e . "$raw/messages.jsonl" >/dev/null; then
    warn "$sid: messages.jsonl did not parse"; return 1
  fi

  # 2. context.json — the harness the model saw, content-addressed.
  local cur blobs comps sha="unknown"
  cur="$(sqlite3 "$ODB" "select current_values from instruction_state where session_id='$sid'")"
  blobs="$(sqlite3 -json "$ODB" "select hash,value from instruction_blob")"
  comps="{}"
  if [[ -n "$cur" ]]; then
    # sha256 over the sorted, newline-terminated "key:blobhash" lines.
    sha="$(jq -r 'to_entries | sort_by(.key) | .[] | "\(.key):\(.value)"' <<< "$cur" | sha256)"
    comps="$(jq -n --argjson cv "$cur" --argjson blobs "${blobs:-[]}" '
      ($blobs | map({key: .hash, value: .value}) | from_entries) as $b
      | $cv | to_entries
      | map({key: .key, value: {hash: .value, value: ($b[.value] // null)}})
      | from_entries')"
  fi

  local models agents state=null
  models="$( { jq -r 'select(.model != null and .model != "") | .model' "$raw/messages.jsonl"
              jq -r '.[0].model // "" | (try fromjson catch null) | if type == "object" then ((.providerID // "") + "/" + (.id // "")) else (. // "") end' <<< "$sess"
            } | sort -u | jq -Rn '[inputs | select(length > 0)]')"
  agents="$( { jq -r 'select(.agent != null and .agent != "") | .agent' "$raw/messages.jsonl"
              jq -r '.[0].agent // ""' <<< "$sess"
            } | sort -u | jq -Rn '[inputs | select(length > 0)]')"
  # Which epoch the snapshot was valid through; null when there is no snapshot.
  if [[ -n "$cur" ]]; then
    state="$(sqlite3 -json "$ODB" "select epoch_start,through_seq from instruction_state where session_id='$sid'" | jq '.[0] // null')"
  fi

  jq -n --argjson sess "$(jq '.[0] | .model |= (try fromjson catch null)' <<< "$sess")" \
        --arg sha "$sha" --argjson comps "$comps" \
        --argjson models "$models" --argjson agents "$agents" \
        --argjson state "$state" \
        '{session: $sess, context_sha: $sha, components: $comps,
          models: $models, agents: $agents, instruction_state: $state}' > "$raw/context.json" || return 1
  jq -e . "$raw/context.json" >/dev/null || { warn "$sid: context.json did not parse"; return 1; }

  # 3. memo skeleton — frontmatter + auto turn outline, [m<seq>] pointers.
  local date slug proj memo rel
  date="$(epoch_date "$((created / 1000))")"
  slug="$(memo_slug "$title" "$(jq -r '.[0].slug // "session"' <<< "$sess")")"
  proj="$(project_of "$dir")"
  memo="$vault/sessions/$date-$slug.md"
  rel="sessions/$date-$slug.md"

  # Never clobber a memo that mining has already curated: re-capturing a
  # session refreshes .raw/ but leaves the annotated memo in place.
  local write_memo=1
  if [[ -f "$memo" ]] && grep -q '^annotated: true' "$memo"; then
    write_memo=0
    log "$sid: $rel is already annotated; leaving the curated memo untouched"
  fi
  if (( write_memo )); then
  {
    printf -- '---\n'
    printf 'session: %s\n' "$sid"
    printf 'date: %s\n' "$date"
    printf 'project: %s\n' "$proj"
    printf 'branch: unknown\n'
    printf 'task: %s\n' "$(yaml_str "$title")"
    printf 'outcome: unknown\n'
    yaml_list models "$models" "" "  "
    printf 'harness:\n'
    yaml_list agents "$agents" "  " "    "
    printf '  context_sha: %s\n' "$sha"
    printf 'annotated: false\n'
    printf 'tags: []\nfailure_modes: []\nharness_updates: []\nsamples: []\n'
    printf -- '---\n\n'
    printf '# %s\n\n' "${title:-$slug}"
    printf '<!-- Skeleton written by `dot transcript` (deterministic, no LLM).\n'
    printf '     `dot transcript --mine` curates the prose, fills the annotation,\n'
    printf '     and emits training rows. Pointers `[m<seq>]` are the `seq` field of\n'
    printf '     `.raw/%s/messages.jsonl`. -->\n\n' "$sid"
    printf '## Goal\n\n'
    printf '## What happened\n'
    if [[ -s "$raw/messages.jsonl" ]]; then
      jq -r '
        def flat: gsub("[ \t\n\r]+"; " ") | sub("^ "; "") | sub(" $"; "");
        def clip(n): if length > n then .[0:n] + "…" else . end;
        "- [m\(.seq)] " + (
          if .type == "assistant" then
            (.content // []) as $c
            | ([$c[] | select(.type == "text") | .text] | join(" ") | flat | clip(110)) as $t
            | ([$c[] | select(.type == "tool") | .name] | unique) as $tools
            | (([$c[] | select(.type == "reasoning")] | length) > 0) as $think
            | ([ (if $t != "" then $t elif ($tools | length) == 0 then "assistant" else empty end),
                 (if ($tools | length) > 0 then "[tools: \($tools | join(","))]" else empty end),
                 (if $think then "[+reasoning]" else empty end) ]
               | if length == 0 then "assistant (empty)" else join(" ") end)
          elif .type == "shell" then
            "shell — $ " + ((.data.command // "") | flat | clip(140)) + " (exit \(.data.exit // "?"))"
          elif .type == "model-switched" then
            "model-switched — \(.data.previous.providerID // "?")/\(.data.previous.id // "?") → \(.data.model.providerID // "?")/\(.data.model.id // "?")"
          elif .type == "agent-switched" then
            "agent-switched — \(.data.previous // "?") → \(.data.agent // "?")"
          elif .type == "location-switched" then
            "location-switched — \(.data.projectID // "?")/\(.data.subpath // "")"
          elif .type == "idle" then
            "idle — \(.data.outcome // "")"
          elif .type == "user" or .type == "synthetic" or .type == "system" then
            .type + " — " + ((.data.text // "") | flat | clip(160))
          else
            .type + " — " + ((.data.text // .data.description // "") | flat | clip(120))
          end
        )' "$raw/messages.jsonl"
    fi
    printf '\n## Verification\n\n## Observations\n<!-- each tagged harness|model|noise -->\n\n'
    printf '## Links\n- raw: `.raw/%s/` (gitignored)\n' "$sid"
  } > "$memo" || return 1
  fi

  log "$sid → $raw/{messages.jsonl,context.json} + $rel"

  if (( can_commit )); then
    if [[ -n "$(git -C "$vault" status --porcelain -- "$rel")" ]]; then
      if git -C "$vault" add -- "$rel" &&
         git -C "$vault" commit -q -m "docs(sessions): add $date-$slug memo"; then
        log "committed $rel"
      else
        warn "$rel: commit failed; memo left uncommitted"
      fi
    else
      log "$rel unchanged"
    fi
  else
    warn "$vault: skipping commit ($why); files written only"
  fi
}

# ── transcript --mine ──────────────────────────────────────────────────
# Mining pass (step 3 of the vault two-multiplier plan). The
# `transcript-eval` agent only reads and reasons; every write below is
# performed by `dot`, so the behaviour is deterministic and testable.
# $DOT_TRANSCRIPT_EVAL_CMD replaces the producer wholesale in tests
# (prompt on stdin, the agent's JSON answer on stdout).
mine_note() { printf '%s==>%s %s\n' "$B" "$R" "$*" >&2; }

memo_field() { sed -n "s/^$2:[[:space:]]*//p" "$1" | head -1; }

parse_agent_json() { # stdin text -> compact JSON on stdout; 1 when unparseable
  local t s
  t="$(cat)"
  t="$(printf '%s\n' "$t" | sed -e '/^[[:space:]]*```[A-Za-z0-9]*[[:space:]]*$/d')"
  if printf '%s' "$t" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$t" | jq -c .; return 0
  fi
  s="${t#*\{}"; s="${s%\}*}"
  if printf '{%s}' "$s" | jq -e . >/dev/null 2>&1; then
    printf '{%s}' "$s" | jq -c .; return 0
  fi
  return 1
}

transcript_eval_text() { # <prompt> ; stdout = the producer's answer text
  local prompt="$1"
  if [[ -n "${DOT_TRANSCRIPT_EVAL_CMD:-}" ]]; then
    printf '%s' "$prompt" | bash -c "$DOT_TRANSCRIPT_EVAL_CMD"
    return $?
  fi
  need opencode
  # `opencode run --agent` runs a subagent standalone, which resolves the model
  # from the global default rather than the agent's frontmatter — so pass it
  # explicitly. `DOT_TRANSCRIPT_EVAL_MODEL=-` defers to opencode's own default.
  local model="${DOT_TRANSCRIPT_EVAL_MODEL:-opencode-go/deepseek-v4.1-flash}"
  local -a cmd=(opencode run --agent "${DOT_TRANSCRIPT_EVAL_AGENT:-transcript-eval}")
  [[ -n "$model" && "$model" != "-" && "$model" != "none" ]] && cmd+=(-m "$model")
  cmd+=(--format json "$prompt")
  "${cmd[@]}" | jq -j 'select(.type == "text") | .part.text'
}

# The agent's system prompt: self-contained, encodes the taxonomy vocabulary,
# the routing rule, and the JSON contract. `dot` owns every write.
mine_prompt() { # <vault> <sid> <memo-rel>
  cat <<EOF
You are transcript-eval, the vault mining agent. You NEVER write files: the
\`dot transcript --mine\` CLI applies your output. You only read and reason.

Vault: $1
Session: $2
Memo skeleton to curate: $1/$3
Raw messages (JSONL, one row per message, ordered by \`seq\`): $1/.raw/$2/messages.jsonl
Harness snapshot (instruction components, models, agents, context_sha): $1/.raw/$2/context.json
Failure taxonomy and routing rule (read it): $1/eval/taxonomy.md

Read the three session files, then emit ONE JSON object and nothing else — no
prose, no markdown fences:

{
  "outcome": "success|partial|failed|abandoned",
  "project": "optional override",
  "branch": "optional; fill only if the session shows the branch",
  "models": ["provider/model"],
  "tags": ["short", "tags"],
  "body": "## Goal\n\n<one paragraph>\n\n## What happened\n- [m12] <turn-grouped, with [m<seq>] pointers>\n\n## Verification\n\n<what proved it>\n\n## Observations\n- \`harness\` <...>\n\n## Links\n- raw: \`.raw/$2/\` (gitignored)",
  "observations": [
    {
      "tag": "harness",
      "family_mode": "family.mode from taxonomy.md",
      "why": "one line — what would have prevented it",
      "evidence": ["m42"],
      "harness_fixable": true,
      "delta": {"file": "learnings.md", "op": "append", "text": "- <the learning>"}
    },
    {
      "tag": "model",
      "family_mode": "reasoning.premature-completion",
      "why": "one line",
      "evidence": ["m57"],
      "harness_fixable": false,
      "samples": [
        {"kind": "step", "through_seq": 56, "failure_mode": ["reasoning.premature-completion"],
         "bad": "<the wrong action>", "ideal": "<the correct action>", "why": "<why>"},
        {"kind": "trajectory", "through_seq": 80, "failure_mode": ["reasoning.premature-completion"],
         "bad": "<summary of the wrong trajectory>", "ideal": "<the corrected trajectory>", "why": "<why>"}
      ]
    }
  ]
}

Rules (non-negotiable):
- One observation is EITHER a delta (harness_fixable true) OR samples (harness_fixable
  false) — never both. A harness-fixable observation must not carry samples: it becomes
  a knowledge delta instead.
- \`noise\` observations carry neither a delta nor samples.
- \`through_seq\` is the \`seq\` of the last raw message included as the model's input. Do NOT
  copy transcripts — the CLI materialises input.system/messages/tools from the raw files.
- For every model failure emit a \`step\` sample and, when the trajectory spans more than
  one turn, a \`trajectory\` sample.
- \`body\` must contain exactly these sections, in order: Goal, What happened, Verification,
  Observations, Links; every observation appears in Observations, tagged
  \`harness\`|\`model\`|\`noise\`.
- delta.file is learnings.md | facts.md | preferences.md | context/<name>.md. For a
  state file also set delta.section to one of "Current state", "Decisions", "Open questions".
- Output ONLY the JSON object.
EOF
}

# The transform from (agent JSON + raw export) to (memo, annotation, samples,
# deltas). All routing/guard/dedup logic lives here, in one place.
JQ_MINE='
def trunc($cap):
  if ((tostring | length) <= $cap) then .
  elif (length <= 1) then .
  else (.[1:] | trunc($cap)) end;
def ish($o): ($o.harness_fixable // ($o.tag == "harness"));
def uniq: reduce .[] as $x ([]; if index($x) then . else . + [$x] end);
def cleanpart: select((.type != "reasoning") or ((.text // "") | length > 0));
def cleanmsg:
  (.data | walk(if type == "object" then del(.reasoningEncryptedContent, .providerState) else . end)) as $d
  | {seq, type, model, agent,
     message: (if ($d.content | type) == "array"
               then ($d | .content = [ .content[] | cleanpart ])
               else $d end)};
def input_for($msgs; $ctx; $through; $cap):
  ([ $msgs[] | select(.seq <= $through) | cleanmsg ]) as $all
  | ($all | trunc($cap)) as $kept
  | { system: (($ctx.components // {}) | to_entries | map(.value.value)
               | map(select(. != null and . != "")) | join("\n\n---\n\n")
               | if . == "" then null else . end),
      tools: ($ctx.components["core/codemode"].value // null),
      messages: $kept,
      truncated: (($kept | length) < ($all | length)),
      dropped: (($all | length) - ($kept | length)) };
($agent) as $a
| ($a.observations // []) as $obs
| [ range(0; ($obs | length)) as $i | ($obs[$i]) + {_i: $i} ] as $obsx
| [ $obsx[] as $o | (($o.samples // [])[]) as $s
    | { obs_i: $o._i, obs_hf: ish($o), tag: ($o.tag // "noise"),
        fm: ($o.family_mode // null), s: $s, in_hf: ($s.harness_fixable // false) } ] as $cand
| [ $cand[] | select((.obs_hf == true) or (.in_hf == true)) ] as $dropped
| [ $cand[] | select(((.obs_hf == true) or (.in_hf == true)) | not) ] as $kept0
| [ $kept0[] as $c
    | ($c.s.kind // "step") as $kind
    | (($c.s.through_seq // 0) | tonumber? // 0) as $ts
    | { id: ($sid + ":" + $kind + ":" + ($ts | tostring)),
        session: $sid, kind: $kind,
        failure_mode: ($c.s.failure_mode // (if $c.fm then [$c.fm] else [] end)),
        harness_fixable: false,
        model: ($c.s.model // (($a.models // [])[0] // (($ctx.models // [])[0]) // null)),
        context_sha: $sha,
        input: input_for($msgs; $ctx; $ts; $cap),
        bad: ($c.s.bad // null), ideal: ($c.s.ideal // null),
        why: ($c.s.why // $c.fm // null),
        observation: $c.obs_i, tag: $c.tag } ] as $samples_all
| [ $samples_all[] | select((.id as $id | ($existing | index($id))) == null) ] as $samples_new
| (if $sha == "unknown" then [] else $samples_new end) as $samples_out
| [ $obsx[] as $o | select(ish($o) == true)
    | { file: (($o.delta.file) // "learnings.md"),
        op: (($o.delta.op) // "append"),
        section: (($o.delta.section) // null),
        text: (($o.delta.text) // ("- " + ($o.family_mode // "harness") + ": " + ($o.why // ""))),
        family_mode: ($o.family_mode // null), why: ($o.why // null),
        evidence: ($o.evidence // []), applied: ($apply == 1) } ] as $deltas
| ($obs | map(.family_mode) | map(select(. != null)) | uniq) as $fmlist
| { samples: $samples_out,
    deltas: $deltas,
    outcome: ($a.outcome // "unknown"),
    body: ($a.body // ""),
    project: ($a.project // null),
    branch: ($a.branch // null),
    tags: ($a.tags // []),
    failure_modes: $fmlist,
    harness_updates: [ $deltas[] | (.file + ": " + ((.text | split("\n")[0]) | .[0:100])) ],
    sample_ids: [ $samples_out[].id ],
    counts: { dropped: ($dropped | length), kept_new: ($samples_out | length),
              dropped_no_context: (($samples_new | length) - ($samples_out | length)) },
    annotation: { session: $sid, memo: $memo_rel, date: $date, context_sha: $sha,
      outcome: ($a.outcome // "unknown"),
      failure_modes: $fmlist,
      observations: [ $obsx[] | { index: ._i, tag: (.tag // "noise"),
        family_mode: (.family_mode // null), why: (.why // null),
        evidence: (.evidence // []),
        route: (if ish(.) then "harness" elif (.tag == "noise") then "noise" else "model" end),
        harness_fixable: ish(.) } ],
      deltas: $deltas,
      samples: [ $samples_out[] | {id, kind, failure_mode, harness_fixable, model} ],
      dropped_samples: [ $dropped[] | {kind: (.s.kind // null),
        through_seq: (.s.through_seq // null), reason: "harness_fixable"} ] } }
'

mine_delta_append() { # <file> <text>
  local f="$1" t="$2"
  mkdir -p "$(dirname "$f")"
  if [[ -s "$f" && -n "$(tail -c1 "$f")" ]]; then printf '\n' >> "$f"; fi
  printf '%s\n' "$t" >> "$f"
}

mine_delta_section() { # <file> <section> <text> — insert at the end of a state-file section
  local f="$1" sec="$2" t="$3" tmp
  if [[ ! -f "$f" ]]; then mine_delta_append "$f" "$t"; return; fi
  tmp="$(mktemp)"
  awk -v heading="## $sec" -v text="$t" '
    { ln[NR] = $0; if ($0 == heading) found = NR }
    END {
      if (!found) { for (i = 1; i <= NR; i++) print ln[i]; print ""; print text; exit }
      end = NR + 1
      for (i = found + 1; i <= NR; i++) if (ln[i] ~ /^## /) { end = i; break }
      for (i = 1; i <= NR; i++) { if (i == end) { print ""; print text }; print ln[i] }
      if (end > NR) { print ""; print text }
    }' "$f" > "$tmp" && mv "$tmp" "$f"
}

transcript_mine() { # <sid> <all> <apply> <vault>
  local sid="$1" all="$2" apply="$3" vault="$4"
  need jq
  vault="$(expand "$vault")"
  [[ -d "$vault" ]] || die "vault directory not found: $vault"
  local sdir="$vault/sessions" adir="$vault/eval/annotations" samples="$vault/eval/samples.jsonl"

  local -a unann=() sel=() f
  if [[ -d "$sdir" ]]; then
    while IFS= read -r f; do unann+=("$f"); done \
      < <(grep -l '^annotated: false' "$sdir"/*.md 2>/dev/null | LC_ALL=C sort)
  fi

  if [[ -n "$sid" ]]; then
    for f in "${unann[@]}"; do [[ "$(memo_field "$f" session)" == "$sid" ]] && sel+=("$f"); done
  elif (( all )); then
    [[ ${#unann[@]} -gt 0 ]] && sel=("${unann[@]}")
  elif [[ ${#unann[@]} -gt 0 ]]; then
    f="$(ls -t "${unann[@]}" 2>/dev/null | head -1)"
    [[ -n "$f" ]] && sel=("$f")
    [[ ${#sel[@]} -gt 0 ]] && mine_note "no selector — newest unannotated: ${sel[0]#$vault/}"
  fi

  # Whether we may commit is a property of the vault checkout, sampled once,
  # before this run writes anything (same policy as `dot transcript`).
  local can_commit=1 why=""
  if ! git -C "$vault" rev-parse --git-dir >/dev/null 2>&1; then
    can_commit=0; why="not a git checkout"
  elif [[ "$(git -C "$vault" symbolic-ref --short -q HEAD 2>/dev/null)" != "main" ]]; then
    can_commit=0; why="HEAD is not main"
  elif [[ -n "$(git -C "$vault" status --porcelain)" ]]; then
    can_commit=0; why="working tree is dirty"
  fi

  local considered=0 annotated=0 skipped=0
  local samples_added=0 samples_dropped=0 deltas_proposed=0 deltas_applied=0
  local -a changed=() report_sessions=()

  for f in ${sel[@]+"${sel[@]}"}; do
    considered=$((considered + 1))
    local rel="${f#$vault/}"
    local ses; ses="$(memo_field "$f" session)"
    if [[ -z "$ses" ]]; then
      skipped=$((skipped + 1)); warn "$rel: no session id in frontmatter; skipped"
      report_sessions+=("$(jq -cn --arg m "$rel" '{session:null,memo:$m,status:"skipped",reason:"no session id"}')")
      continue
    fi
    local raw="$vault/.raw/$ses"
    if [[ ! -s "$raw/messages.jsonl" || ! -f "$raw/context.json" ]]; then
      skipped=$((skipped + 1)); warn "$ses: raw export missing ($raw); skipped"
      report_sessions+=("$(jq -cn --arg s "$ses" --arg m "$rel" '{session:$s,memo:$m,status:"skipped",reason:"raw export missing"}')")
      continue
    fi

    mine_note "mining $rel ($ses)"
    local text json
    text="$(transcript_eval_text "$(mine_prompt "$vault" "$ses" "$rel")")" || true
    if [[ -z "$text" ]] || ! json="$(printf '%s' "$text" | parse_agent_json)"; then
      skipped=$((skipped + 1)); warn "$ses: transcript-eval produced no parseable JSON; skipped"
      report_sessions+=("$(jq -cn --arg s "$ses" --arg m "$rel" '{session:$s,memo:$m,status:"skipped",reason:"agent output not JSON"}')")
      continue
    fi
    if [[ "$(jq -r 'if (.observations|type) == "array" then "ok" else "no" end' <<< "$json")" != "ok" ]]; then
      skipped=$((skipped + 1)); warn "$ses: agent output has no observations[]; skipped"
      report_sessions+=("$(jq -cn --arg s "$ses" --arg m "$rel" '{session:$s,memo:$m,status:"skipped",reason:"no observations"}')")
      continue
    fi

    local date slug title sha ctx_json mir
    date="$(basename "$f" | sed -n 's/^\([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\)-.*/\1/p')"
    slug="$(basename "$f" .md)"; slug="${slug#"$date"-}"
    ctx_json="$(cat "$raw/context.json")"
    title="$(jq -r '.session.title // ""' <<< "$ctx_json")"
    sha="$(jq -r '.context_sha // "unknown"' <<< "$ctx_json")"
    [[ -n "$date" ]] || date="$(jq -r '.date // "undated"' <<< "$json")"

    local existing="[]"
    if [[ -s "$samples" ]]; then
      existing="$(jq -r '.id // empty' "$samples" 2>/dev/null | jq -Rn '[inputs]' 2>/dev/null)" || existing="[]"
      [[ -n "$existing" ]] || existing="[]"
    fi

    mir="$(jq -n -c \
      --argjson agent "$json" --argjson ctx "$ctx_json" \
      --slurpfile msgs "$raw/messages.jsonl" \
      --arg sid "$ses" --arg sha "$sha" --arg date "$date" \
      --arg memo_rel "$rel" --argjson cap "${DOT_TRANSCRIPT_INPUT_CAP:-1000000}" \
      --argjson existing "$existing" --argjson apply "$apply" \
      "$JQ_MINE")" || { skipped=$((skipped + 1)); warn "$ses: transform failed; skipped"; \
        report_sessions+=("$(jq -cn --arg s "$ses" --arg m "$rel" '{session:$s,memo:$m,status:"skipped",reason:"transform failed"}')"); continue; }

    # ── write 1: the curated memo
    local outcome fm_models fm_agents fm_tags fm_fm fm_hu fm_ids fm_proj fm_branch body anno_rel
    outcome="$(jq -r '.outcome' <<< "$mir")"
    case "$outcome" in success|partial|failed|abandoned) ;; *) outcome="unknown" ;; esac
    body="$(jq -r '.body' <<< "$mir")"
    fm_proj="$(jq -r '.project // empty' <<< "$mir")"; [[ -n "$fm_proj" ]] || fm_proj="$(memo_field "$f" project)"
    fm_branch="$(jq -r '.branch // empty' <<< "$mir")"; [[ -n "$fm_branch" ]] || fm_branch="$(memo_field "$f" branch)"
    [[ -n "$fm_branch" ]] || fm_branch="unknown"
    fm_models="$(jq -c 'if (.models|length) > 0 and (.models|type)=="array" then .models else . end' <<< "$ctx_json")"
    fm_agents="$(jq -c '.agents // []' <<< "$ctx_json")"
    fm_tags="$(jq -c '.tags' <<< "$mir")"
    fm_fm="$(jq -c '.failure_modes' <<< "$mir")"
    fm_hu="$(jq -c '.harness_updates' <<< "$mir")"
    fm_ids="$(jq -c '.sample_ids' <<< "$mir")"
    {
      printf -- '---\n'
      printf 'session: %s\n' "$ses"
      printf 'date: %s\n' "$date"
      printf 'project: %s\n' "$fm_proj"
      printf 'branch: %s\n' "$fm_branch"
      printf 'task: %s\n' "$(yaml_str "$title")"
      printf 'outcome: %s\n' "$outcome"
      yaml_list models "$fm_models" "" "  "
      printf 'harness:\n'
      yaml_list agents "$fm_agents" "  " "    "
      printf '  context_sha: %s\n' "$sha"
      printf 'annotated: true\n'
      yaml_list tags "$fm_tags" "" "  "
      yaml_list failure_modes "$fm_fm" "" "  "
      yaml_list harness_updates "$fm_hu" "" "  "
      yaml_list samples "$fm_ids" "" "  "
      printf -- '---\n\n'
      printf '# %s\n\n' "$title"
      printf '%s\n' "$body"
    } > "$f" || { skipped=$((skipped + 1)); warn "$ses: memo write failed; skipped"; continue; }

    # ── write 2: the audit annotation
    mkdir -p "$adir"
    anno_rel="eval/annotations/$date-$slug.json"
    jq --argjson models "$fm_models" --argjson agents "$fm_agents" \
       '.annotation + {models: $models, agents: $agents, tags: .tags,
                       harness_updates: .harness_updates}' <<< "$mir" > "$vault/$anno_rel" \
      || { skipped=$((skipped + 1)); warn "$ses: annotation write failed; skipped"; continue; }

    # ── write 3: append-only samples (dedup happened in the transform)
    local added dropped dn
    added="$(jq -r '.counts.kept_new' <<< "$mir")"
    dropped="$(jq -r '.counts.dropped + .counts.dropped_no_context' <<< "$mir")"
    dn="$(jq -r '.deltas | length' <<< "$mir")"
    if (( added > 0 )); then
      jq -c '.samples[]' <<< "$mir" >> "$samples" || { skipped=$((skipped + 1)); warn "$ses: samples append failed; skipped"; continue; }
    fi

    # ── write 4: harness deltas (proposed always, applied with --apply)
    if (( apply )) && (( dn > 0 )); then
      local i=0 dfile dtext dsec
      while (( i < dn )); do
        dfile="$(jq -r ".deltas[$i].file" <<< "$mir")"
        dtext="$(jq -r ".deltas[$i].text" <<< "$mir")"
        dsec="$(jq -r ".deltas[$i].section // empty" <<< "$mir")"
        case "$dfile" in
          /*|*..*|"") dfile="learnings.md" ;;
        esac
        case "$dfile" in
          learnings.md|facts.md|preferences.md) mine_delta_append "$vault/$dfile" "$dtext" ;;
          context/*.md) mine_delta_section "$vault/$dfile" "${dsec:-Open questions}" "$dtext" ;;          *) dfile="learnings.md"; mine_delta_append "$vault/$dfile" "$dtext" ;;
        esac
        changed+=("$dfile")
        deltas_applied=$((deltas_applied + 1))
        i=$((i + 1))
      done
    fi

    annotated=$((annotated + 1))
    samples_added=$((samples_added + added))
    samples_dropped=$((samples_dropped + dropped))
    deltas_proposed=$((deltas_proposed + dn))
    changed+=("$rel" "$anno_rel")
    (( added > 0 )) && changed+=("eval/samples.jsonl")
    report_sessions+=("$(jq -cn --arg s "$ses" --arg m "$rel" \
      --argjson sa "$added" --argjson sd "$dropped" --argjson dn "$dn" \
      '{session:$s,memo:$m,status:"annotated",samples:$sa,samples_dropped:$sd,deltas:$dn}')")
  done

  # Commit only the content files mining changed, and only from a clean
  # checkout on main (mirrors `dot transcript`).
  if (( annotated > 0 )); then
    if (( can_commit )); then
      local msg
      if (( annotated == 1 )); then msg="docs(eval): annotate $(basename "${sel[0]}" .md)"
      else msg="docs(eval): annotate $annotated session(s)"; fi
      if git -C "$vault" add -- ${changed[@]+"${changed[@]}"} && \
         git -C "$vault" commit -q -m "$msg"; then
        mine_note "committed mining output to vault main"
      else
        warn "$vault: commit failed; files written only"
      fi
    else
      warn "$vault: skipping commit ($why); files written only"
    fi
  fi

  local sessions_json="[]"
  if (( ${#report_sessions[@]} > 0 )); then
    sessions_json="$(printf '%s\n' ${report_sessions[@]+"${report_sessions[@]}"} | jq -s '.')"
  fi
  jq -cn \
    --arg vault "$vault" --argjson apply "$apply" \
    --argjson considered "$considered" --argjson annotated "$annotated" \
    --argjson skipped "$skipped" --argjson samples_added "$samples_added" \
    --argjson samples_dropped "$samples_dropped" --argjson deltas_proposed "$deltas_proposed" \
    --argjson deltas_applied "$deltas_applied" --argjson sessions "$sessions_json" \
    '{command:"transcript --mine", vault:$vault, apply:($apply == 1),
      considered:$considered, annotated:$annotated, skipped:$skipped,
      samples_added:$samples_added, samples_dropped:$samples_dropped,
      deltas_proposed:$deltas_proposed, deltas_applied:$deltas_applied,
      sessions:$sessions}'
  (( considered == 0 )) && mine_note "0 to annotate"
  return 0
}

cmd_transcript() {
  local sid="" all=0 mine=0 apply=0 vault="${DOT_VAULT:-$HOME/vault}"
  while (( $# )); do
    case "$1" in
      --all) all=1; shift ;;
      --mine) mine=1; shift ;;
      --apply) apply=1; shift ;;
      --vault) [[ -n "${2:-}" ]] || die "--vault needs a directory"; vault="$2"; shift 2 ;;
      --vault=*) vault="${1#*=}"; shift ;;
      --session) [[ -n "${2:-}" ]] || die "--session needs a session id"; sid="$2"; shift 2 ;;
      --session=*) sid="${1#*=}"; shift ;;
      -*) die "unknown flag: $1 (usage: dot transcript [<session>] [--all] [--vault DIR] | dot transcript --mine [<session>|--all] [--apply] [--vault DIR])" ;;
      *) sid="$1"; shift ;;
    esac
  done

  vault="$(expand "$vault")"
  [[ -d "$vault" ]] || die "vault directory not found: $vault"

  if (( mine )); then
    transcript_mine "$sid" "$all" "$apply" "$vault"
    return
  fi

  need sqlite3; need jq
  [[ -f "$ODB" ]] || die "opencode session store not found: $ODB (override with DOT_OPENCODE_DB)"

  local ids=() id
  if [[ -n "$sid" ]]; then
    [[ -n "$(sqlite3 "$ODB" "select id from session_v2 where id='$sid'")" ]] || die "no such session: $sid"
    ids=("$sid")
  elif (( all )); then
    while IFS= read -r id; do [[ -n "$id" ]] && ids+=("$id"); done < <(sqlite3 "$ODB" "select id from session_v2 order by time_created")
    [[ ${#ids[@]} -gt 0 ]] || die "no sessions in $ODB"
  else
    local recent; recent="$(sqlite3 -json "$ODB" "select id,title from session_v2 order by time_updated desc limit 1")"
    [[ "$recent" != "[]" && -n "$recent" ]] || die "no sessions in $ODB"
    sid="$(jq -r '.[0].id' <<< "$recent")"
    log "no session given — using $sid, the most recently updated: $(jq -r '.[0].title // "(untitled)"' <<< "$recent")"
    ids=("$sid")
  fi

  # Whether we may commit is a property of the vault checkout, not of each
  # session: sample it once, before this run writes anything.
  local can_commit=1 why=""
  if ! git -C "$vault" rev-parse --git-dir >/dev/null 2>&1; then
    can_commit=0; why="not a git checkout"
  elif [[ "$(git -C "$vault" symbolic-ref --short -q HEAD 2>/dev/null)" != "main" ]]; then
    can_commit=0; why="HEAD is not main"
  elif [[ -n "$(git -C "$vault" status --porcelain)" ]]; then
    can_commit=0; why="working tree is dirty"
  fi

  local n=0
  for id in "${ids[@]}"; do
    transcript_export "$id" "$vault" "$can_commit" "$why" || return 1
    n=$((n + 1))
  done
  log "captured $n session(s) into $vault"
}

# ── dispatch ───────────────────────────────────────────────────────────
usage() {
  cat <<EOF
dot $DOT_VERSION — versioned, selective dotfiles CLI

Config lifecycle:
  dot init [--profile P] [--repo URL] [--ref R] [--ephemeral]
  dot apply [<config>…] [--profile P] [--dry-run] [--force-post]
  dot forget <config>…            remove links (store kept)
  dot update [<config>…] [--no-pull]
  dot rollback <config> [version]
  dot status [--exit-code] [--json]
  dot diff <config>
  dot doctor
  dot list [--installed|--available] [--json]
  dot info <config>
  dot profiles
  dot edit <config>
  dot add <path>
  dot bump <config> <major|minor|patch>
  dot cd
  dot gc [--dry-run]
  dot purge [--yes]

Runtime:
  dot name <type> <word>…         canonical task id
  dot transcript [<session>] [--all] [--vault DIR]
                                  export a session: .raw/ + memo skeleton
  dot transcript --mine [<session>|--session ID|--all] [--apply] [--vault DIR]
                                  curate unannotated memos: memo + annotation
                                  + eval/samples.jsonl rows; propose harness
                                  deltas (write them with --apply)
  dot up | task | review | web

Env: DOT_REPO DOT_STORE DOT_STATE DOT_BIN_DIR DOT_REPO_URL DOT_REF
     DOT_VAULT DOT_OPENCODE_DB DOT_TRANSCRIPT_INPUT_CAP
     DOT_TRANSCRIPT_EVAL_CMD DOT_TRANSCRIPT_EVAL_AGENT DOT_TRANSCRIPT_EVAL_MODEL
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    apply) cmd_apply "$@" ;;
    forget|uninstall) cmd_forget "$@" ;;
    update) cmd_update "$@" ;;
    rollback) cmd_rollback "$@" ;;
    status) cmd_status "$@" ;;
    diff) cmd_diff "$@" ;;
    doctor) cmd_doctor "$@" ;;
    list|ls) cmd_list "$@" ;;
    info) cmd_info "$@" ;;
    profiles) cmd_profiles "$@" ;;
    edit) cmd_edit "$@" ;;
    add) cmd_add "$@" ;;
    bump) cmd_bump "$@" ;;
    cd) cmd_cd "$@" ;;
    gc) cmd_gc "$@" ;;
    purge) cmd_purge "$@" ;;
    name) cmd_name "$@" ;;
    transcript) cmd_transcript "$@" ;;
    up|task|review|web) runtime_stub "$cmd" "$@" ;;
    version|--version|-V) printf 'dot %s\n' "$DOT_VERSION" ;;
    ""|help|--help|-h) usage ;;
    *) die "unknown command: $cmd (try: dot --help)" ;;
  esac
}
main "$@"
