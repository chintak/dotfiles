{
  "terminal": {
    "copy_on_select": true
  },
  "preferred_line_length": 100,
  "soft_wrap": "editor_width",
  "markdown_preview": {
    "code_font_family": "JetBrainsMono Nerd Font Mono"
  },
  "ui_font_size": 16.0,
  "ui_font_family": "Source Serif 4",
  "agent_ui_font_size": 18.0,
  "agent_ui_font_family": "Source Serif 4",
  "buffer_line_height": "comfortable",
  "buffer_font_size": 13.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "agent_buffer_font_size": 15.0,
  "agent_buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "focus_follows_mouse": {
    "enabled": true
  },
  "helix_mode": true,
  "disable_ai": true,
  "cli_default_open_behavior": "existing_window",
  "completion_menu_item_kind": "symbol",
  "format_on_save": "modifications_if_available",
  "gutter": {
    "min_line_number_digits": 2
  },
  "horizontal_scroll_margin": 99.0,
  "vertical_scroll_margin": 99.0,
  "cursor_shape": "block",
  "cursor_blink": false,
  "search": {
    "regex": true,
    "center_on_match": true
  },
  "autosave": "on_focus_change",
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "theme": {
    "mode": "system",
    "light": "Dayfox - opaque",
    "dark": "Nordfox - blurred"
  },
  "agent": {
    "thinking_display": "preview",
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "sandbox_permissions": {
      "allow_all_hosts": true
    },
    "single_file_review": true,
    "default_profile": "auto",
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4.1-flash",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "profiles": {
      "auto": {
        "name": "Auto",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "model_parameters": []
  },
  "context_servers": {
    "Roblox_Studio": {
      "command": "/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"
    }
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "html": true,
    "jetbrains-themes": true,
    "just": true,
    "latex": true,
    "material-icon-theme": true,
    "nvim-nightfox": true,
    "one-dark-pro": true,
    "toml": true,
    "tsgo": true
  }
}
