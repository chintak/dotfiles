// Multi-agent layout for running parallel coding agents
// Usage: zellij --layout agents
//
// SOURCE OF TRUTH: ~/Documents/dotfiles/zellij/layouts/agents.kdl

layout {
    tab name="agents" {
        // Three equal panes for running multiple agents side by side
        pane split_direction="vertical" {
            pane {
                name "agent-1"
                focus true
            }
            pane {
                name "agent-2"
            }
            pane {
                name "agent-3"
            }
        }
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="review" {
        // Single pane for reviewing agent output, diffs, etc.
        pane {
            name "review"
        }
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
}
