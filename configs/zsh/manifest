version     = 1.7.0
description = zsh — secrets/env sourced from .zshenv (non-interactive too); PATH, history, fzf, dot-completion fpath hook, prompt switch, color/readability (incl. RICH_THEME=dracula default), herdr TERM fix, alt-word keys, tool aliases
file        = zshenv|~/.zshenv
file        = zshrc|~/.zshrc
file@mac-personal = zshrc.d/pnpm.zsh|~/.zshrc.d/pnpm.zsh
post_apply  = rm -f "$HOME/.zcompdump"
