# Ghostty — herdr is the multiplexer; Ghostty is the renderer.
# Docs: https://ghostty.org/docs/config

# ── look ───────────────────────────────────────────────────────────────
# Block cursor, no blink
cursor-style = block
cursor-style-blink = false
# Minimal chrome: herdr owns tabs/panes, so each Ghostty window is a
# single surface with no titlebar. `hidden` (not `window-decoration =
# none`) keeps rounded corners + shadow. Drag via option+click.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
theme = "TokyoNight Night"
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = hidden
# let alt chords reach herdr
macos-option-as-alt = true
window-save-state = always

# ── quick terminal: cmd+shift+` from anywhere ──────────────────────────
keybind = global:cmd+shift+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# ── hand Ghostty's chords to herdr ─────────────────────────────────────
# Ghostty's own split/tab chords are freed so herdr receives them. In
# 1.3.x its native Split menu can win over `unbind`, so the split chords
# are emitted as explicit Kitty CSI-u sequences instead.
keybind = performable:super+d=text:\x1b[100;9u
keybind = performable:super+shift+d=text:\x1b[100;10u
keybind = performable:super+[=text:\x1b[91;9u
keybind = performable:super+]=text:\x1b[93;9u
keybind = performable:super+shift+enter=text:\x1b[13;10u
# ── word/line navigation → Helix ─────────────────────────────────────
# Ghostty's macOS defaults send readline bytes here (esc:b/esc:f,
# Ctrl-A/Ctrl-E) which fight Helix's insert mode, so override them.
# herdr forwards all of these untouched (matches no [keys] chord).
# Helix binds A-left/A-right; Home/End already mean line start/end.
keybind = alt+arrow_left=csi:1;3D
keybind = alt+arrow_right=csi:1;3C
keybind = cmd+arrow_left=text:\x1bOH
keybind = cmd+arrow_right=text:\x1bOF
# ── herdr pane/tab/workspace arrows → herdr ──────────────────────────
# This is the shift+alt+left/right fix. Ghostty ships no default for
# shift+alt+arrows, but without an explicit bind the chord can be
# swallowed (selection handling / macOS composition) and surface inside
# the pane as a word jump — which looks like Helix stealing it. Send
# xterm CSI with mods=4 (shift+alt) so herdr matches previous_tab /
# next_tab / previous_workspace / next_workspace instead of forwarding
# the bytes to Helix.
keybind = shift+alt+arrow_left=csi:1;4D
keybind = shift+alt+arrow_right=csi:1;4C
keybind = shift+alt+arrow_up=csi:1;4A
keybind = shift+alt+arrow_down=csi:1;4B
# ── cmd chords → herdr (CSI-u, Kitty keyboard protocol) ───────────────
# `unbind` alone is NOT enough for cmd chords: super has no legacy pty
# encoding, so an unbound cmd chord is dropped and herdr never sees it.
# Forward every cmd chord herdr binds as an explicit CSI-u sequence, the
# same pattern as the super+d split forwards above (mods 9 = super,
# 10 = shift+super, 11 = super+alt, 13 = super+ctrl; letters/digits are
# USB HID codes: t=116 w=119 n=110 p=112 [=91 ]=93 1..9=49..57).
keybind = performable:super+alt+arrow_up=csi:1;11A
keybind = performable:super+alt+arrow_down=csi:1;11B
keybind = performable:super+alt+arrow_left=csi:1;11D
keybind = performable:super+alt+arrow_right=csi:1;11C
keybind = performable:super+ctrl+arrow_up=csi:1;13A
keybind = performable:super+ctrl+arrow_down=csi:1;13B
keybind = performable:super+ctrl+arrow_left=csi:1;13D
keybind = performable:super+ctrl+arrow_right=csi:1;13C
keybind = performable:super+t=text:\x1b[116;9u
keybind = performable:super+w=text:\x1b[119;9u
keybind = performable:super+n=text:\x1b[110;9u
keybind = performable:super+p=text:\x1b[112;9u
keybind = performable:super+shift+[=text:\x1b[91;10u
keybind = performable:super+shift+]=text:\x1b[93;10u
keybind = performable:super+shift+w=text:\x1b[119;10u
# cmd+1..9 — free both the character and the physical-key trigger, and
# forward both as CSI-u so herdr sees switch_workspace.
keybind = performable:super+1=text:\x1b[49;9u
keybind = performable:super+digit_1=text:\x1b[49;9u
keybind = performable:super+2=text:\x1b[50;9u
keybind = performable:super+digit_2=text:\x1b[50;9u
keybind = performable:super+3=text:\x1b[51;9u
keybind = performable:super+digit_3=text:\x1b[51;9u
keybind = performable:super+4=text:\x1b[52;9u
keybind = performable:super+digit_4=text:\x1b[52;9u
keybind = performable:super+5=text:\x1b[53;9u
keybind = performable:super+digit_5=text:\x1b[53;9u
keybind = performable:super+6=text:\x1b[54;9u
keybind = performable:super+digit_6=text:\x1b[54;9u
keybind = performable:super+7=text:\x1b[55;9u
keybind = performable:super+digit_7=text:\x1b[55;9u
keybind = performable:super+8=text:\x1b[56;9u
keybind = performable:super+digit_8=text:\x1b[56;9u
keybind = performable:super+9=text:\x1b[57;9u
keybind = performable:super+digit_9=text:\x1b[57;9u

# ── clipboard ──────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
# broken on macOS 26 in Ghostty 1.3.x
copy-on-select = false
selection-clear-on-copy = true

# ── behavior ───────────────────────────────────────────────────────────
# agents emit a lot of output
scrollback-limit = 100000000
# herdr keeps processes alive anyway
confirm-close-surface = false
shell-integration = detect
# no-cursor: keep cursor-style=block at prompt (default forces bar)
shell-integration-features = no-cursor,sudo,title
