{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "focus",
  "lsp": true,
  "formatter": true,
  "worktree": {
    // Worktrees for the `do` agent live in <repo>/.worktrees/
    "directory": ".worktrees",
  },
  "mcp": {
    "servers": {
      "roblox-studio": {
        "type": "local",
        "command": [
          "/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"
        ]
      },
      // arXiv paper search/reading, PDF Q&A, researcher lookup. OAuth 2.1:
      // sign in via /mcps on first use.
      "alphaxiv": {
        "type": "remote",
        "url": "https://api.alphaxiv.org/mcp/v1"
      },
      // HuggingFace models/datasets/spaces search, model cards, HF daily
      // papers. OAuth: sign in via /mcps on first use.
      "huggingface": {
        "type": "remote",
        "url": "https://huggingface.co/mcp"
      },
      // GitHub repos/issues/PRs. Uses gh CLI credentials: GITHUB_TOKEN is
      // exported in ~/.env as $(gh auth token); oauth disabled (Copilot MCP
      // endpoint doesn't support OpenCode's OAuth flow).
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      },
      // Exa semantic web search for trend signals (blogs, launches, X
      // threads). Needs EXA_API_KEY exported in the shell env.
      "exa": {
        "type": "local",
        "command": ["npx", "-y", "exa-mcp-server"],
        "environment": {
          "EXA_API_KEY": "{env:EXA_API_KEY}"
        }
      }
    }
  },
  "agents": {
    // Focus is the default primary agent. The built-in build/plan primaries
    // are disabled; implementation stays delegated to the `do` subagent.
    "build": {
      "disabled": true,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "/private/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "~/git/*", "effect": "deny" },
        { "action": "edit", "resource": "~/vault/*", "effect": "deny" },
        { "action": "subagent", "resource": "do", "effect": "allow" }
      ]
    },
    "plan": {
      "disabled": true
    }
  }
}
