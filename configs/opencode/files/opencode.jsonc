{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "focus",
  "lsp": true,
  "formatter": true,
  "worktree": {
    // Worktrees for the `do` agent live in <repo>/.worktrees/
    "directory": ".worktrees",
  },
  "mcp": {
    "servers": {
      "roblox-studio": {
        "type": "local",
        "command": [
          "/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"
        ]
      },
      // arXiv paper search/reading, PDF Q&A, researcher lookup. OAuth 2.1:
      // sign in via /mcps on first use.
      "alphaxiv": {
        "type": "remote",
        "url": "https://api.alphaxiv.org/mcp/v1"
      },
      // HuggingFace models/datasets/spaces search, model cards, HF daily
      // papers. Authenticated via {env:HF_TOKEN}, persisted for the daemon from
      // the hf CLI (`opencode service set env HF_TOKEN "$(cat
      // ~/.cache/huggingface/token)"`), not from ~/.env. oauth disabled —
      // header auth avoids anonymous rate limits.
      "huggingface": {
        "type": "remote",
        "url": "https://huggingface.co/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:HF_TOKEN}"
        }
      },
      // GitHub repos/issues/PRs. Personal access token (PAT) — GitHub's
      // documented remote pattern (`oauth: false` + Authorization header).
      // Use a fine-grained PAT in GITHUB_PERSONAL_ACCESS_TOKEN; persist it
      // for the daemon with `opencode service set env GITHUB_PERSONAL_ACCESS_TOKEN`.
      // Do NOT use GITHUB_TOKEN (the gh CLI gho_ token): unsupported, expires,
      // and a left-over GITHUB_TOKEN is a documented 401 cause.
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      // Exa semantic web search for trend signals (blogs, launches, X
      // threads). Needs EXA_API_KEY exported in the shell env.
      "exa": {
        "type": "local",
        "command": ["npx", "-y", "exa-mcp-server"],
        "environment": {
          "EXA_API_KEY": "{env:EXA_API_KEY}"
        }
      }
    }
  },
  "agents": {
    // Focus is the default primary agent. The built-in build/plan primaries
    // are disabled; implementation stays delegated to the `do` subagent.
    "build": {
      "disabled": true,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "/private/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "~/git/*", "effect": "deny" },
        { "action": "edit", "resource": "~/vault/*", "effect": "deny" },
        { "action": "subagent", "resource": "do", "effect": "allow" }
      ]
    },
    "plan": {
      "disabled": true
    }
  }
}
