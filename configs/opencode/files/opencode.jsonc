{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "worktree": {
    // Worktrees for the `do` agent live in <repo>/.worktrees/
    "directory": ".worktrees",
  },
  "mcp": {
    "servers": {
      "roblox-studio": {
        "type": "local",
        "command": [
          "/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"
        ]
      }
    }
  },
  "agents": {
    // Lock the default Build agent: edits only in tmp. ALL writes under
    // ~/git/ and ~/vault/ — including .worktrees/ — must be delegated to
    // the `do` agent, which owns the worktree protocol there.
    "build": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "/private/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "~/git/*", "effect": "deny" },
        { "action": "edit", "resource": "~/vault/*", "effect": "deny" },
        { "action": "subagent", "resource": "do", "effect": "allow" }
      ]
    }
  }
}
